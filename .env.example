# Guest learning works without authentication keys.
# Match the port/domain actually serving Kotoba (this workspace currently uses port 3002).
APP_URL=http://localhost:3000
# Clerk keys: https://dashboard.clerk.com (secret key is server-only)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/hn/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/hn/register
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/hn/learn
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/hn/learn
CLERK_AUTHORIZED_PARTIES=http://localhost:3000
# Required for persistent account data on Vercel; dev uses ignored .data/accounts/ files.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
